{
  "name": "tapehead-native",
  "private": true,
  "version": "1.12.15",
  "description": "Capacitor wrapper that packages Tapehead Pro for the App Store and Google Play",
  "scripts": {
    "icons": "npx @capacitor/assets generate --iconBackgroundColor #0A0A0C --splashBackgroundColor #0A0A0C",
    "sync": "npx cap sync",
    "android": "npx cap open android",
    "ios": "npx cap open ios",
    "android:add": "npx cap add android",
    "ios:add": "npx cap add ios",
    "android:sync": "npx cap sync android",
    "ios:sync": "npx cap sync ios",
    "verify:mobile": "node scripts/verify-mobile-package.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/assets": "^3.0.0"
  }
}
